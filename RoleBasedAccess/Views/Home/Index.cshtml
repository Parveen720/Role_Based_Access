@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">

    <h1 class="display-4">
        @Localizer["Role Based Access System"]
    </h1>

    <p class="lead">
        @Localizer["ASP.NET Core MVC + JWT Authentication + Role Based Authorization"]
    </p>

    <br />

    @if (!User.Identity!.IsAuthenticated)
    {
        <a asp-controller="Auth"
           asp-action="Login"
           class="btn btn-primary btn-lg">
            @Localizer["Login"]
        </a>
    }
    else
    {
        <h4>Welcome @User.Identity.Name</h4>
    }

</div>