@model RoleBasedAccess.Models.Entities.User

<h2>Student Profile</h2>

<table class="table table-bordered">

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Role</th>
        <td>@Model.Role</td>
    </tr>

</table>