@model IEnumerable<RoleBasedAccess.Models.Entities.User>

<h2>Faculties</h2>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var faculty in Model)
        {
            <tr>
                <td>@faculty.Name</td>
                <td>@faculty.Email</td>
                <td>@faculty.Role</td>
            </tr>
        }

    </tbody>

</table>