@model List<RoleBasedAccess.Models.Entities.User>

<h1>Faculties</h1>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
    </tr>

    @foreach (var faculty in Model)
    {
        <tr>
            <td>@faculty.Id</td>
            <td>@faculty.Name</td>
            <td>@faculty.Email</td>
        </tr>
    }
</table>