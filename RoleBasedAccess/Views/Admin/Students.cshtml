@model IEnumerable<RoleBasedAccess.Models.Entities.User>

<h2>Students</h2>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Name</td>
                <td>@student.Email</td>
                <td>@student.Role</td>
            </tr>
        }

    </tbody>

</table>